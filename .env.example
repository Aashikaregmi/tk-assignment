PORT=3000
LOG_LEVEL=info

# Postgres (docker compose). Containers use DB_HOST=postgres (set in compose.yaml).
DB_HOST=localhost
DB_PORT=5432
# Integration tests use DB_NAME + "_test", created by docker/postgres/init.
DB_NAME=vizy
# Owns the schema and runs migrations. Superuser inside the local container.
DB_OWNER_USER=vizy_owner
DB_OWNER_PASSWORD=
# Least-privilege role the API connects as: row reads/writes only, no DDL.
DB_USER=vizy_app
DB_PASSWORD=
