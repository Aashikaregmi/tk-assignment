PORT=3000
LOG_LEVEL=info
# HS256 signing key, at least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=

# Postgres (docker compose). Containers use DB_HOST=postgres (set in compose.yaml).
DB_HOST=localhost
DB_PORT=5432
# Integration tests use DB_NAME + "_test", created by docker/postgres/init.
DB_NAME=vizy
# Owns the schema and runs migrations. Superuser inside the local container.
DB_OWNER_USER=vizy_owner
DB_OWNER_PASSWORD=
# Least-privilege role the API connects as: row reads/writes only, no DDL.
DB_USER=vizy_app
DB_PASSWORD=

# Redis (docker compose) for BullMQ queues. Containers use REDIS_HOST=redis (set in compose.yaml).
REDIS_HOST=localhost
REDIS_PORT=6379
# Integration tests use REDIS_DB + 1 (see test/test-env.ts).
REDIS_DB=0
# Simulated risk provider: fail the first N calls per submission (0 = never). 5+ exhausts the retries.
RISK_PROVIDER_FAILURES=0

# npm run seed: password for the five fake @example.com users (at least 12 characters).
SEED_USER_PASSWORD=
