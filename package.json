{
  "name": "merchant-applications-api",
  "version": "0.0.0",
  "private": true,
  "description": "Merchant application onboarding API: NestJS, hexagonal architecture, CQRS",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . && npm run lint:arch",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test": "jest"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    },
    "setupFiles": [
      "reflect-metadata"
    ],
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  }
}
